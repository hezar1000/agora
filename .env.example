# Production settings for /etc/agora/agora.env (systemd EnvironmentFile format:
# NAME=value, no `export`). Replace every placeholder; deploy/preflight.sh
# refuses to start the workers while any remain. See docs/DEPLOYING.md.
# Never commit populated secrets or certificates.
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DATABASE_URL=postgresql://agora:replace-me@127.0.0.1:5432/agora
DATABASE_CONN_MAX_AGE=0
REDIS_URL=redis://127.0.0.1:6379/0
DJANGO_ALLOWED_HOSTS=agora.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://agora.example.edu
# Host header used by the direct-to-worker systemd liveness probe.
AGORA_PROBE_HOST=agora.example.edu
DJANGO_DEBUG=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

DJANGO_STATIC_ROOT=/home/agora/agora-data/staticfiles
DJANGO_MEDIA_ROOT=/home/agora/agora-data/media
DJANGO_LOG_FILE=/var/log/agora/django.log
DJANGO_EVENTS_LOG_FILE=/var/log/agora/events.log
DJANGO_DEBUG_LOG_FILE=/var/log/agora/debug.log
DJANGO_REQUEST_LOG_FILE=/var/log/agora/requests.log

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=agora-help@example.edu

# Second factor for password sign-ins (SSO accounts never see it).
MFA_ENFORCED=true

# Let people create their own password accounts.
SIGNUP_ENABLED=false
# Let anyone try a throwaway demonstration class from the sign-in page.
GUEST_SESSIONS_ENABLED=false
# Let any signed-in account create a course. When false, only superusers and
# existing instructors can.
OPEN_COURSE_CREATION=false
# Sign in through your institution's SAML identity provider. Its endpoints and
# attributes are set in mta2/saml_settings.py; see docs/DEPLOYING.md.
SAML2_INTEGRATION_ENABLED=true
SAML_ENTITY_ID=https://agora.example.edu/
SAML_SP_PUBLIC_CERT_FILE=/etc/agora/saml/sp.crt
SAML_SP_PRIVATE_KEY_FILE=/etc/agora/saml/sp.key
SAML_IDP_PUBLIC_CERT_FILE=/etc/agora/saml/idp.crt
SAML_TECHNICAL_CONTACT_EMAIL=agora-help@example.edu
SAML_SUPPORT_CONTACT_EMAIL=agora-help@example.edu

# Isolated local development only. Never set this in staging or production.
# DJANGO_ALLOW_INSECURE_LOCAL_DEFAULTS=1
